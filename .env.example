# Adress till en formulärtjänst (t.ex. Formspree). Lämna tomt för att använda mailto-läget.
PUBLIC_FORM_ENDPOINT=
# Publik åtkomstnyckel om tjänsten kräver en (t.ex. Web3Forms). Annars tomt.
PUBLIC_FORM_ACCESS_KEY=

# Kakfri besöksstatistik (valfritt – utan dessa laddas ingen mätning). Välj EN tjänst:
# Plausible: ange domänen som är registrerad hos tjänsten, t.ex. fyratassar.nu
PUBLIC_PLAUSIBLE_DOMAIN=
# Egen adress till Plausible-skriptet om ni kör egen installation. Annars tomt.
PUBLIC_PLAUSIBLE_SCRIPT=
# GoatCounter: koden från kontot, t.ex. fyratassar (blir fyratassar.goatcounter.com)
PUBLIC_GOATCOUNTER=

# Verifiering för sökmotorer (valfritt). Koden hittar ni i Google Search Console respektive Bing Webmaster Tools.
PUBLIC_GOOGLE_VERIFICATION=
PUBLIC_BING_VERIFICATION=
