---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/playfair-display/wght.css';
import '../styles/global.css';
import latinRubrikTypsnitt from '../../node_modules/@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import latinTypsnitt from '../../node_modules/@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SnabbFalt from '../components/SnabbFalt.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/site';
import { oppettiderSchema } from '../lib/oppettider';
import { bild } from '../data/bilder';
import { team } from '../data/team';
import { tjanster } from '../data/tjanster';

interface Props {
  title: string;
  description: string;
  /** Egen titel utan suffix (startsidan) */
  heltTitel?: boolean;
  noindex?: boolean;
  ogBild?: string;
  /** Extra JSON-LD-block för sidan */
  jsonLd?: Record<string, unknown>[];
  /** Schema.org-typ för sidan i sig (standard WebPage) */
  sidtyp?: 'WebPage' | 'ContactPage' | 'AboutPage' | 'CollectionPage';
}

const { title, description, heltTitel = false, noindex = false, ogBild = '/og-bild.png', jsonLd = [], sidtyp = 'WebPage' } = Astro.props;

// Kort varumärke i titeln ("| Fyra Tassar") så att nyckelorden får plats inom ca 60 tecken
const fullTitel = heltTitel ? title : `${title} | ${site.kortnamn}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogBild, site.url).href;

const foretag = {
  '@context': 'https://schema.org',
  '@type': 'PetStore',
  '@id': `${site.url}/#butik`,
  name: site.namn,
  legalName: site.juridisktNamn,
  description: site.beskrivning,
  url: site.url,
  slogan: site.slogan,
  telephone: site.telefon.href.replace('tel:', ''),
  email: site.epost,
  image: ogUrl,
  logo: new URL(bild('logo').src, site.url).href,
  currenciesAccepted: 'SEK',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: site.telefon.href.replace('tel:', ''),
    email: site.epost,
    availableLanguage: 'sv',
  },
  employee: team.map((p) => ({ '@type': 'Person', name: p.namn, jobTitle: p.roll })),
  knowsAbout: ['hundfoder', 'kattfoder', 'kloklippning', 'hundtrim', 'hundkurser', 'hundfriskvård'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Tjänster',
    itemListElement: tjanster.map((t) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: t.namn, url: new URL(`/tjanster/${t.slug}/`, site.url).href },
    })),
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adress.gata,
    postalCode: site.adress.postnummer,
    addressLocality: site.adress.ort,
    addressRegion: 'Dalarnas län',
    addressCountry: 'SE',
  },
  hasMap: site.adress.kartaUrl,
  openingHoursSpecification: oppettiderSchema(site.oppettider),
  sameAs: site.sociala.map((s) => s.url),
  areaServed: site.adress.ort,
};

// Webbplatsens namn i sökresultaten (bara på startsidan) och sidan själv, kopplade till butiken
const webbplats = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#webbplats`,
  url: site.url,
  name: site.namn,
  alternateName: site.kortnamn,
  inLanguage: 'sv',
  publisher: { '@id': `${site.url}/#butik` },
};
const sida = {
  '@context': 'https://schema.org',
  '@type': sidtyp,
  '@id': `${canonical}#sida`,
  url: canonical,
  name: fullTitel,
  description,
  inLanguage: 'sv',
  isPartOf: { '@id': `${site.url}/#webbplats` },
  about: { '@id': `${site.url}/#butik` },
};
const ldBlock = [...(Astro.url.pathname === '/' ? [webbplats] : []), ...(noindex ? [] : [sida]), ...jsonLd];
---

<!doctype html>
<html lang="sv" data-rorelse={site.rorelse}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!noindex && <link rel="alternate" hreflang="sv" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    {site.verifiering.google && <meta name="google-site-verification" content={site.verifiering.google} />}
    {site.verifiering.bing && <meta name="msvalidate.01" content={site.verifiering.bing} />}
    <meta name="theme-color" content="#141414" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={latinTypsnitt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinRubrikTypsnitt} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.namn} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={fullTitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.namn} – ${site.slogan}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitel} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(foretag)} />
    {ldBlock.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
      // Inladdningsvy: bara på startsidan, en gång per besök och aldrig vid "reducera rörelse".
      // Sidans egna animationer väntar tills ridån lyfts; en säkerhetstimer släpper dem alltid.
      (function () {
        var d = document.documentElement;
        try {
          if (location.pathname !== '/' || sessionStorage.getItem('ft-intro')) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          sessionStorage.setItem('ft-intro', '1');
        } catch (e) {
          return;
        }
        var start = Date.now();
        var klar = false;
        function slut() {
          if (klar) return;
          klar = true;
          d.classList.add('intro-klar');
          setTimeout(function () {
            d.classList.remove('intro-pa');
          }, 1000);
        }
        function laddad() {
          setTimeout(slut, Math.max(1200 - (Date.now() - start), 0));
        }
        d.classList.add('intro-pa');
        if (document.readyState === 'complete') laddad();
        else addEventListener('load', laddad);
        setTimeout(slut, 2600);
      })();
    </script>

    {
      site.analys.plausibleDomain && (
        <>
          <script is:inline>
            window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
          </script>
          <script is:inline defer data-domain={site.analys.plausibleDomain} src={site.analys.plausibleSkript}></script>
        </>
      )
    }
    {
      !site.analys.plausibleDomain && site.analys.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${site.analys.goatcounter}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }

    <noscript>
      <style>
        .nav-toggle {
          display: none;
        }
        .nav {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Intro />
    <a class="skip-link" href="#innehall">Hoppa till innehållet</a>
    <Header />
    <main id="innehall" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SnabbFalt />

    <script>
      import '../scripts/liv';
    </script>

    <script>
      // Mjuk inglidning av innehåll när det kommer in i bild. Utan JS (eller med reducerad
      // rörelse) visas allt direkt.
      const reducerad = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mal = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-stagger], [data-inview], [data-tassspar]');
      if (reducerad || !('IntersectionObserver' in window)) {
        mal.forEach((el) => el.classList.add('is-in'));
      } else {
        mal.forEach((el) => {
          el.querySelectorAll(':scope > *').forEach((barn, i) => (barn as HTMLElement).style.setProperty('--i', String(i)));
        });
        const io = new IntersectionObserver(
          (poster) => {
            for (const p of poster) {
              if (p.isIntersecting) {
                p.target.classList.add('is-in');
                io.unobserve(p.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        mal.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
