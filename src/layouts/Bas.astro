---
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SnabbFalt from '../components/SnabbFalt.astro';
import { site } from '../data/site';
import { oppettiderSchema } from '../lib/oppettider';

interface Props {
  title: string;
  description: string;
  /** Egen titel utan suffix (startsidan) */
  heltTitel?: boolean;
  noindex?: boolean;
  ogBild?: string;
  /** Extra JSON-LD-block för sidan */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, heltTitel = false, noindex = false, ogBild = '/og-bild.png', jsonLd = [] } = Astro.props;

const fullTitel = heltTitel ? title : `${title} | ${site.namn}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogBild, site.url).href;

const foretag = {
  '@context': 'https://schema.org',
  '@type': 'PetStore',
  '@id': `${site.url}/#butik`,
  name: site.namn,
  legalName: site.juridisktNamn,
  description: site.beskrivning,
  url: site.url,
  telephone: '+46243-86860',
  email: site.epost,
  image: ogUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adress.gata,
    postalCode: site.adress.postnummer,
    addressLocality: site.adress.ort,
    addressCountry: 'SE',
  },
  hasMap: site.adress.kartaUrl,
  openingHoursSpecification: oppettiderSchema(site.oppettider),
  sameAs: site.sociala.map((s) => s.url),
  areaServed: site.adress.ort,
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#d4147b" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.namn} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={fullTitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.namn} – ${site.slogan}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(foretag)} />
    {jsonLd.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <noscript>
      <style>
        .nav-toggle {
          display: none;
        }
        .nav {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#innehall">Hoppa till innehållet</a>
    <Header />
    <main id="innehall" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SnabbFalt />

    <script>
      // Ljuspunkt som följer musen över element med data-spot (bara med mus, och inte vid reducerad rörelse)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });
      }
    </script>

    <script>
      // Mjuk inglidning av innehåll när det kommer in i bild. Utan JS (eller med reducerad
      // rörelse) visas allt direkt.
      const reducerad = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mal = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-stagger], [data-inview]');
      if (reducerad || !('IntersectionObserver' in window)) {
        mal.forEach((el) => el.classList.add('is-in'));
      } else {
        mal.forEach((el) => {
          el.querySelectorAll(':scope > *').forEach((barn, i) => (barn as HTMLElement).style.setProperty('--i', String(i)));
        });
        const io = new IntersectionObserver(
          (poster) => {
            for (const p of poster) {
              if (p.isIntersecting) {
                p.target.classList.add('is-in');
                io.unobserve(p.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        mal.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
