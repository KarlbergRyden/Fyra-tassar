---
import Bas from '../layouts/Bas.astro';
import Icon from '../components/Icon.astro';
import PageBanner from '../components/PageBanner.astro';
import KategoriPanel from '../components/KategoriPanel.astro';
import ProduktKort from '../components/ProduktKort.astro';
import Avslut from '../components/Avslut.astro';
import Tassspar from '../components/Tassspar.astro';
import { kategorier, fodermarken, leverantorer, utvaldProdukt } from '../data/produkter';
import { produkterFor, webbshopOppen } from '../data/webbshop';
import { site } from '../data/site';

const hund = kategorier.find((k) => k.id === 'hund')!;
const katt = kategorier.find((k) => k.id === 'katt')!;
const oppen = webbshopOppen();
---

<Bas
  title="Webbshop för hund och katt"
  sidtyp="CollectionPage"
  description="Webbshop för hund och katt i Borlänge, öppnar snart. Foder, koppel, sängar, kattsand och klösträd. Hela sortimentet finns i butiken."
>
  <div class="page-dark">
    <PageBanner
      titel="Webbshop"
      ingress={oppen
        ? 'Foder och tillbehör till hund och katt, hem till dig.'
        : 'Foder och tillbehör till hund och katt. Webbshopen öppnar snart – tills dess hittar du hela sortimentet i butiken.'}
      steg={[{ text: 'Webbshop' }]}
      etikett={oppen ? 'Webbshop' : 'Öppnar snart'}
    >
      <a class="btn" href={site.telefon.href} data-spor="ring"><Icon namn="phone" storlek={18} />Ring och fråga</a>
      <a class="btn btn--light" href="/erbjudanden/">Se erbjudanden</a>
    </PageBanner>

    <h2 class="sr-only">Produktkategorier</h2>
    <div class="container">
      <div class="filter" role="group" aria-label="Visa produkter för" data-filter>
        <button class="filter__btn" type="button" data-visa="alla" aria-pressed="true">Alla</button>
        <button class="filter__btn" type="button" data-visa="hund" aria-pressed="false">Hund</button>
        <button class="filter__btn" type="button" data-visa="katt" aria-pressed="false">Katt</button>
      </div>
    </div>

    <KategoriPanel kategori={hund} bild="bannerSkog" sida="vanster" rubrik="Allt till hunden" />
    <section class="shop" data-kategori="hund" aria-labelledby="shop-hund">
      <div class="container">
        <h3 class="shop__rubrik" id="shop-hund" data-reveal>
          {oppen ? 'Webbshop – hund' : 'Snart i webbshopen – hund'}
        </h3>
        <div class="shop__grid" data-kompakt="true" data-reveal-stagger>
          {produkterFor('hund').map((p, i) => <ProduktKort produkt={p} extra={i >= 4} />)}
        </div>
        <p class="shop__mer" data-mer>
          <button class="btn btn--light btn--sm" type="button" aria-expanded="false" data-visa-alla>Visa alla</button>
        </p>
      </div>
    </section>

    <KategoriPanel kategori={katt} bild="bannerKatt" sida="hoger" rubrik="Allt till katten" />
    <section class="shop" data-kategori="katt" aria-labelledby="shop-katt">
      <div class="container">
        <h3 class="shop__rubrik" id="shop-katt" data-reveal>
          {oppen ? 'Webbshop – katt' : 'Snart i webbshopen – katt'}
        </h3>
        <div class="shop__grid" data-kompakt="true" data-reveal-stagger>
          {produkterFor('katt').map((p, i) => <ProduktKort produkt={p} extra={i >= 4} />)}
        </div>
        <p class="shop__mer" data-mer>
          <button class="btn btn--light btn--sm" type="button" aria-expanded="false" data-visa-alla>Visa alla</button>
        </p>
      </div>
    </section>

    <section class="section section--tint" id="foder" aria-labelledby="foder-rubrik">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="eyebrow">Foder</p>
          <h2 id="foder-rubrik">Fodermärken</h2>
          <p>
            Torrfoder och mer för hund och katt från bland annat dessa märken.
            <a href="/hitta-foder/" data-spor="passar-foderhjalp">Osäker på vilket? Hitta rätt foder.</a>
          </p>
        </div>
        <details class="faldbar" id="marken" data-reveal>
          <summary>Visa alla märken ({fodermarken.length})</summary>
          <ul class="chips">
            {fodermarken.map((m) => <li>{m}</li>)}
          </ul>
        </details>
      </div>
    </section>

    <section class="section" id="utvald" aria-labelledby="utvald-rubrik">
      <div class="container">
        <div class="feature" data-reveal>
          <div>
            <p class="eyebrow">Utvald produkt</p>
            <h2 id="utvald-rubrik">{utvaldProdukt.rubrik}</h2>
            <p class="lead">{utvaldProdukt.text}</p>
            <ul class="checklist mt-5">
              {
                utvaldProdukt.punkter.map((p) => (
                  <li><Icon namn="check" storlek={22} /><span>{p}</span></li>
                ))
              }
            </ul>
            <div class="btn-row mt-6">
              <a class="btn" href="/kontakt/">Fråga om hundbur</a>
            </div>
          </div>
          <div class="feature__panel">
            <Icon namn="shield" storlek={44} />
            <h3 class="mt-5">Ett bur som tål bilfärden</h3>
            <p class="mb-0">Se det i butiken och prova storleken tillsammans med din hund.</p>
          </div>
        </div>
      </div>
    </section>

    <Tassspar />

    <section class="section section--tint" id="bestall" aria-labelledby="bestall-rubrik">
      <div class="container">
        <div>
          <div data-reveal>
            <p class="eyebrow">Beställning</p>
            <h2 id="bestall-rubrik">Hittar du inte det du söker?</h2>
            <p class="lead">
              Vi beställer hem produkter som vi inte har i butiken, om det går.{' '}
              {oppen
                ? 'Pris och lagerstatus ser du i webbshopen och i butiken.'
                : 'Webbshopen är under uppbyggnad – tills vidare ser du pris och lagerstatus i butiken.'}
            </p>
            <div class="btn-row mt-6">
              <a class="btn" href="/kontakt/">Fråga oss</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="lev-rubrik">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="eyebrow">Leverantörer</p>
          <h2 id="lev-rubrik">Märken vi arbetar med</h2>
          <p>Tillbehör, hälso- och pälsvård från bland annat dessa leverantörer.</p>
        </div>
        <details class="faldbar" data-reveal>
          <summary>Visa alla leverantörer ({leverantorer.length})</summary>
          <ul class="chips">
            {leverantorer.map((m) => <li>{m}</li>)}
          </ul>
        </details>
      </div>
    </section>
    <Avslut />
  </div>
</Bas>

<script>
  // Filter (enbart förbättring – utan JS visas alla kategorier och produkter)
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  if (filter) {
    filter.hidden = false;
    const knappar = filter.querySelectorAll<HTMLButtonElement>('[data-visa]');
    const sektioner = document.querySelectorAll<HTMLElement>('[data-kategori]');
    const visa = (vad: string) => {
      knappar.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.visa === vad)));
      sektioner.forEach((s) => {
        s.hidden = vad !== 'alla' && s.dataset.kategori !== vad;
      });
    };
    knappar.forEach((k) => k.addEventListener('click', () => visa(k.dataset.visa!)));
    // Länkar som #hund / #katt förväljer kategori
    const fran = location.hash.replace('#', '');
    if (fran === 'hund' || fran === 'katt') visa(fran);
  }

  // Produktrutnät: fyra kort per djur först, resten med "Visa alla" (utan JS visas alla)
  document.querySelectorAll<HTMLElement>('.shop__grid').forEach((grid) => {
    const extra = grid.querySelectorAll('[data-extra]').length;
    const rad = grid.parentElement?.querySelector<HTMLElement>('[data-mer]');
    const knapp = rad?.querySelector<HTMLButtonElement>('[data-visa-alla]');
    if (!extra || !rad || !knapp) {
      if (rad) rad.hidden = true; // inget att fälla ut
      return;
    }
    const totalt = grid.querySelectorAll('.produkt').length;
    grid.dataset.kompakt = 'true';
    knapp.textContent = `Visa alla ${totalt}`;
    rad.hidden = false;
    knapp.addEventListener('click', () => {
      const kompakt = grid.dataset.kompakt === 'true';
      grid.dataset.kompakt = String(!kompakt);
      knapp.setAttribute('aria-expanded', String(kompakt));
      knapp.textContent = kompakt ? 'Visa färre' : `Visa alla ${totalt}`;
    });
  });

  // Länk till #marken öppnar märkeslistan
  if (location.hash === '#marken') document.querySelector<HTMLDetailsElement>('#marken')?.setAttribute('open', '');

  // Panelernas rörelse: parallax på bilden (av vid reducerad rörelse)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const paneler = [...document.querySelectorAll<HTMLElement>('.cat-panel')];
    let vantar = false;
    const rita = () => {
      vantar = false;
      for (const p of paneler) {
        const media = p.querySelector<HTMLElement>('[data-parallax]');
        const r = p.getBoundingClientRect();
        if (!media || r.bottom < 0 || r.top > window.innerHeight) continue;
        const framsteg = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight; // ≈ -1 … 1
        media.style.transform = `translate3d(0, ${(framsteg * -48).toFixed(1)}px, 0)`;
      }
    };
    const planera = () => {
      if (!vantar) {
        vantar = true;
        requestAnimationFrame(rita);
      }
    };
    window.addEventListener('scroll', planera, { passive: true });
    window.addEventListener('resize', planera);
    rita();
  }
</script>
