---
import Bas from '../layouts/Bas.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Bild from '../components/Bild.astro';
import { site } from '../data/site';

const facebook = site.sociala.find((s) => s.namn === 'Facebook')!;
const kursepost = 'AnetteZim@hotmail.com';

// Rubriken delas upp i ord som glider in ett i taget, som på startsidan
const rubrik = ['Hundkurser', 'för', 'dig', 'och', 'din', 'hund'];

// Det kunden får – som glaskort i hjälten
// Tre kort med allt som behövs. Det sista är en länk: frågor går till Anette.
const kundFar = [
  { ikon: 'cap', titel: 'En kurs', text: 'för dig och din hund', href: undefined as string | undefined },
  { ikon: 'facebook', titel: 'Enkel anmälan', text: 'i butiken eller via Facebook', href: undefined as string | undefined },
  { ikon: 'mail', titel: 'Frågor?', text: 'Mejla Anette', href: `mailto:${kursepost}` },
];

const mer = [
  { href: '/tjanster/kloklippning/', namn: 'Kloklippning', text: '160 kr' },
  { href: '/tjanster/hundfriskvard/', namn: 'Hundfriskvård', text: 'Nillans hundhälsa' },
  { href: '/webbshop/', namn: 'Webbshop', text: 'Foder och tillbehör' },
];
---

<Bas
  title="Hundkurser i Borlänge"
  description="Hundkurser i Borlänge. Anmäl dig i butiken eller via Facebook, och ställ frågor om kurserna till Anette."
>
  <div class="page-dark">
    <!-- Foto-hero i samma stil som startsidan: mörk, kontrastrik, utan interaktion -->
    <section class="hero-photo hero-photo--kurs on-dark" aria-labelledby="kurs-rubrik">
      <div class="hero-photo__media">
        <Bild class="hero-photo__img" namn="kursledare" sizes="100vw" prioritet />
      </div>
      <div class="container hero-photo__wrap">
        <div class="hero-photo__in">
          <Breadcrumbs steg={[{ text: 'Kurser' }]} />
          <p class="eyebrow">Kurser</p>
          <h1 id="kurs-rubrik">
            {
              rubrik.map((ord, i) => (
                <>
                  {i > 0 && ' '}
                  <span class="w">
                    <span style={`--i:${i}`}>{ord}</span>
                  </span>
                </>
              ))
            }
          </h1>
          <div class="btn-row">
            <a class="btn" href={facebook.url} target="_blank" rel="noopener noreferrer" data-spor="kurs-facebook"
              ><Icon namn="facebook" storlek={18} />Anmäl via Facebook<span class="sr-only"> (öppnas i ny flik)</span></a
            >
            <a class="btn btn--light" href={site.telefon.href} data-spor="ring"><Icon namn="phone" storlek={18} />Ring {site.telefon.visning}</a>
          </div>
        </div>

        <ul class="glass-cards" aria-label="Det här får du som kund">
          {
            kundFar.map((k, i) => (
              <li style={`--i:${i}`}>
                {k.href ? (
                  <a class="glass-card" href={k.href} data-spor="epost">
                    <span class="glass-card__icon"><Icon namn={k.ikon} storlek={22} /></span>
                    <span>
                      <strong>{k.titel}</strong>
                      <small>{k.text}</small>
                    </span>
                  </a>
                ) : (
                  <div class="glass-card glass-card--static">
                    <span class="glass-card__icon"><Icon namn={k.ikon} storlek={22} /></span>
                    <span>
                      <strong>{k.titel}</strong>
                      <small>{k.text}</small>
                    </span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section--tight" aria-labelledby="mer-rubrik">
      <div class="container">
        <h2 id="mer-rubrik" class="sr-only">Mer för dig och hunden</h2>
        <ul class="more-row">
          {
            mer.map((m) => (
              <li>
                <a href={m.href}>{m.namn}<Icon namn="arrow" storlek={18} /></a>
                <small>{m.text}</small>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Bas>
