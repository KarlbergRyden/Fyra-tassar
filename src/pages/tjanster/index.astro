---
import Bas from '../../layouts/Bas.astro';
import PageBanner from '../../components/PageBanner.astro';
import TjanstVaeljare, { type ValjbarTjanst } from '../../components/TjanstVaeljare.astro';
import Avslut from '../../components/Avslut.astro';
import { tjanster } from '../../data/tjanster';
import { site } from '../../data/site';

const facebook = site.sociala.find((s) => s.namn === 'Facebook')!;

const meta: Record<string, string> = {
  kloklippning: 'Boka online',
  hundtrim: 'Boka via sms · även katt',
  hundfriskvard: 'Massage · laser · elektroterapi',
};
const utfors: Record<string, string> = {
  kloklippning: 'Butikens egna kloklippare',
  hundtrim: 'Anna-Lena’s hundtrim',
  hundfriskvard: 'Nillans hundhälsa',
};

const valjbara: ValjbarTjanst[] = [
  ...tjanster.map((t) => ({
    id: t.slug,
    namn: t.namn,
    kundnytta: t.kundnytta,
    kundFar: t.kundFar,
    pris: t.pris,
    tid: t.slug === 'kloklippning' ? 'Vanligtvis tisdagar ca 15–19' : undefined,
    utfors: utfors[t.slug] ?? '',
    steg: t.steg,
    bild: t.bild,
    cta: t.cta,
    merHref: `/tjanster/${t.slug}/`,
    meta: meta[t.slug] ?? '',
  })),
  {
    id: 'hundkurser',
    namn: 'Hundkurser',
    kundnytta: 'Kurser för dig och din hund, med anmälan direkt i butiken.',
    kundFar: [
      'En kurs för dig och din hund',
      'Anmälan i butiken eller via Facebook',
      'Frågor om kurserna besvaras av Anette',
    ],
    pris: { rubrik: 'Fråga Anette', text: '' },
    utfors: 'Butiken',
    steg: [{ titel: 'Välj hur du anmäler dig', text: '' }, { titel: 'Fråga om du undrar något', text: '' }, { titel: 'Kom till kursen', text: '' }],
    bild: 'bannerHund',
    cta: { text: 'Anmäl via Facebook', href: facebook.url, extern: true },
    merHref: '/kurser/',
    meta: 'Anmälan i butiken',
  },
];


---

<Bas
  title="Tjänster för hund i Borlänge"
  sidtyp="CollectionPage"
  description="Kloklippning, hundtrim, hundfriskvård och hundkurser i Borlänge. Se vad du får som kund, vad det kostar, vem som utför tjänsten och hur du bokar."
>
  <div class="page-dark">
    <PageBanner
      titel="Tjänster för dig och din hund"
      ingress="Välj en tjänst och se direkt vad du får, vad det kostar och hur du bokar."
      steg={[{ text: 'Tjänster' }]}
      etikett="Tjänster"
    >
      <a class="btn" href={site.bokningUrl} rel="noopener" data-spor="tjanster-boka">Boka kloklippning</a>
      <a class="btn btn--light" href="/priser/">Se priser</a>
    </PageBanner>

    <section class="section" aria-labelledby="valj-rubrik">
      <div class="container">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">Välj tjänst</p>
            <h2 id="valj-rubrik">Vad vill du ha hjälp med?</h2>
          </div>
          <p>Klicka dig fram. Du ser vad du får, vad det kostar, vem som utför tjänsten och hur du bokar.</p>
        </div>
        <TjanstVaeljare tjanster={valjbara} />
      </div>
    </section>

    <Avslut rubrik="Osäker på vilken tjänst som passar?" text="Ring eller skriv så hjälper vi dig att välja." />
  </div>
</Bas>
