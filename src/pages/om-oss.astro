---
import Bas from '../layouts/Bas.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Bild from '../components/Bild.astro';
import Avslut from '../components/Avslut.astro';
import Tal from '../components/Tal.astro';
import Avatar from '../components/Avatar.astro';
import Tassspar from '../components/Tassspar.astro';
import { team } from '../data/team';

// Rubriken delas upp i ord som glider in ett i taget, som på startsidan
const rubrik = 'Den personliga butiken i Borlänge'.split(' ');

const siffror = [
  { tal: 20, enhet: ' år', text: 'i djurbutik' },
  { tal: team.length, enhet: '', text: 'personer i butiken' },
];

---

<Bas
  title="Om oss – den personliga butiken i Borlänge"
  description="Möt teamet bakom Fyra Tassar i Borlänge: butiksägaren Lotta Andersson med 20 års erfarenhet av djurbutik, och personalen som hjälper dig och ditt djur."
>
  <div class="page-dark">
    <!-- Hero: text till vänster, teamet svävande i rosa sken till höger -->
    <section class="about-hero on-dark" aria-labelledby="om-rubrik">
      <div class="container about-hero__grid">
        <div class="about-hero__text">
          <Breadcrumbs steg={[{ text: 'Om oss' }]} />
          <p class="eyebrow">Om oss</p>
          <h1 id="om-rubrik">
            {
              rubrik.map((ord, i) => (
                <>
                  {i > 0 && ' '}
                  <span class="w">
                    <span style={`--i:${i}`}>{ord}</span>
                  </span>
                </>
              ))
            }
          </h1>
          <p class="lead">
            Fyra Tassar är en djurbutik med foder och tillbehör till hund och katt. Här möter du personal som själva har
            djur och som kan svara på dina frågor.
          </p>
          <ul class="about-stats" aria-label="Fyra Tassar i siffror">
            {siffror.map((s) => <li><strong><Tal varde={s.tal} />{s.enhet}</strong><span>{s.text}</span></li>)}
          </ul>
        </div>
        <div class="about-hero__stage">
          <Bild namn="team" sizes="(min-width: 64rem) 46vw, 100vw" prioritet />
        </div>
      </div>
    </section>

    <Tassspar />

    <section class="section" aria-labelledby="team-rubrik">
      <div class="container">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">Teamet</p>
            <h2 id="team-rubrik">Personerna i butiken</h2>
          </div>
          <p>Möt dem som hjälper dig och ditt djur när du kommer in.</p>
        </div>
        <div class="team-grid" data-reveal-stagger>
          {
            team.map((p) => (
              <article class="person-card" data-tilt>
                <Avatar namn={p.namn} fotoId={p.foto} />
                <div>
                  <h3>{p.namn}</h3>
                  <p class="person-card__roll">{p.roll}</p>
                  <p class="person-card__text">{p.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Avslut rubrik="Kom förbi och hälsa på" text="Vi svarar gärna på frågor om foder, tillbehör och våra tjänster." />
  </div>
</Bas>
