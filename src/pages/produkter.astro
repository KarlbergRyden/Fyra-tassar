---
import Bas from '../layouts/Bas.astro';
import Icon from '../components/Icon.astro';
import PageBanner from '../components/PageBanner.astro';
import KategoriPanel from '../components/KategoriPanel.astro';
import SlutCta from '../components/SlutCta.astro';
import { kategorier, fodermarken, leverantorer, utvaldProdukt } from '../data/produkter';
import { aktivaErbjudanden } from '../data/erbjudanden';
import { site } from '../data/site';

const hund = kategorier.find((k) => k.id === 'hund')!;
const katt = kategorier.find((k) => k.id === 'katt')!;
const erbjudanden = aktivaErbjudanden();

const trygghet = [
  { ikon: 'box', text: 'Brett sortiment för hund och katt' },
  { ikon: 'tag', text: 'Aktuella foderkampanjer' },
  { ikon: 'shield', text: 'Kunnig personal – 20 års erfarenhet' },
  { ikon: 'parking', text: 'Gratis parkering utanför' },
];
---

<Bas
  title="Produkter till hund och katt i Borlänge"
  description="Foder och tillbehör till hund och katt i Borlänge: koppel, selar, sängar, kattsand, klösträd och foder från bland annat Royal Canin, Eukanuba och Taste of the Wild."
>
  <div class="page-dark">
    <PageBanner
      titel="Produkter till hund och katt"
      ingress="Foder och tillbehör för både vardag och träning. Saknar du något? Fråga oss – vi beställer hem det om det går."
      steg={[{ text: 'Produkter' }]}
      etikett="Sortiment"
    >
      <a class="btn" href={site.telefon.href} data-spor="ring"><Icon namn="phone" storlek={18} />Ring och fråga</a>
      <a class="btn btn--light" href="#kampanjer">Se kampanjer</a>
    </PageBanner>

    <div class="infostrip on-dark">
      <div class="container">
        <ul class="infostrip__list">
          {trygghet.map((t) => <li><Icon namn={t.ikon} storlek={20} />{t.text}</li>)}
        </ul>
      </div>
    </div>

    <h2 class="sr-only">Produktkategorier</h2>
    <div class="container">
      <div class="filter" role="group" aria-label="Visa produkter för" data-filter hidden>
        <button class="filter__btn" type="button" data-visa="alla" aria-pressed="true">Alla</button>
        <button class="filter__btn" type="button" data-visa="hund" aria-pressed="false">Hund</button>
        <button class="filter__btn" type="button" data-visa="katt" aria-pressed="false">Katt</button>
      </div>
    </div>

    <KategoriPanel kategori={hund} bild="bannerSkog" sida="vanster" rubrik="Allt till hunden" />
    <KategoriPanel kategori={katt} bild="bannerKatt" sida="hoger" rubrik="Allt till katten" />

    <section class="section--tight" aria-label="Pris och lagerstatus">
      <div class="container">
        <p class="text-soft mb-0">
          Pris och lagerstatus ser du i butiken. Vi har ingen webbutik – ring eller mejla så kollar vi gärna om vi har
          det du söker.
        </p>
      </div>
    </section>

    <!-- ===== Foder och kampanjer: här finns köpbeslutet ===== -->
    <section class="section" id="kampanjer" aria-labelledby="kampanjer-rubrik">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="eyebrow"><Icon namn="tag" storlek={18} />Erbjudanden</p>
          <h2 id="kampanjer-rubrik">Foderkampanjer i butiken</h2>
          <p>Priserna gäller i butiken. Hämta hem foder till kampanjpris.</p>
        </div>
        {
          erbjudanden.length > 0 && (
            <div class="grid grid--4" data-reveal-stagger>
              {erbjudanden.map((e) => (
                <article class="deal">
                  <h3>{e.namn}</h3>
                  <p>{e.detalj}</p>
                  <div class="deal__prices">
                    <span class="deal__price">{e.pris} kr</span>
                    <span class="deal__old">
                      <span class="sr-only">Ordinarie pris</span>
                      {e.franPris ? 'från ' : ''}
                      {e.ordinarie} kr
                    </span>
                  </div>
                </article>
              ))}
            </div>
          )
        }
        <div class="btn-row mt-6">
          <a class="btn" href={site.adress.kartaUrl} target="_blank" rel="noopener noreferrer" data-spor="karta"
            ><Icon namn="pin" storlek={18} />Hitta hit<span class="sr-only"> (öppnas i ny flik)</span></a
          >
          <a class="btn btn--light" href="/erbjudanden/">Alla erbjudanden</a>
        </div>
      </div>
    </section>

    <section class="section section--tint" id="foder" aria-labelledby="foder-rubrik">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="eyebrow">Foder</p>
          <h2 id="foder-rubrik">Fodermärken</h2>
          <p>Torrfoder och mer för hund och katt från bland annat dessa märken.</p>
        </div>
        <ul class="chips" id="marken" data-reveal>
          {fodermarken.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" id="utvald" aria-labelledby="utvald-rubrik">
      <div class="container">
        <div class="feature" data-reveal>
          <div>
            <p class="eyebrow">Utvald produkt</p>
            <h2 id="utvald-rubrik">{utvaldProdukt.rubrik}</h2>
            <p class="lead">{utvaldProdukt.text}</p>
            <ul class="checklist mt-5">
              {
                utvaldProdukt.punkter.map((p) => (
                  <li><Icon namn="check" storlek={22} /><span>{p}</span></li>
                ))
              }
            </ul>
            <div class="btn-row mt-6">
              <a class="btn" href="/kontakt/">Fråga om hundbur</a>
            </div>
          </div>
          <div class="feature__panel">
            <Icon namn="shield" storlek={44} />
            <h3 class="mt-5">Ett bur som tål bilfärden</h3>
            <p class="mb-0">Se det i butiken och prova storleken tillsammans med din hund.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tint" id="bestall" aria-labelledby="bestall-rubrik">
      <div class="container">
        <div class="split split--even">
          <div data-reveal>
            <p class="eyebrow">Beställning</p>
            <h2 id="bestall-rubrik">Hittar du inte det du söker?</h2>
            <p class="lead">
              Vi beställer hem produkter som vi inte har i butiken, om det går. Hör av dig så berättar vi vad som är
              möjligt.
            </p>
            <div class="btn-row mt-6">
              <a class="btn" href={site.telefon.href} data-spor="ring"><Icon namn="phone" storlek={18} />Ring {site.telefon.visning}</a>
              <a class="btn btn--light" href="/kontakt/">Skriv till oss</a>
            </div>
          </div>
          <ol class="steps" data-reveal-stagger>
            <li>
              <h3>Berätta vad du söker</h3>
              <p>Kom förbi, ring eller skriv till oss och säg vilken produkt du är ute efter.</p>
            </li>
            <li>
              <h3>Vi kollar om vi kan beställa hem den</h3>
              <p>Vi tittar på vad som går att få tag i via våra leverantörer.</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="lev-rubrik">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="eyebrow">Leverantörer</p>
          <h2 id="lev-rubrik">Märken vi arbetar med</h2>
          <p>Tillbehör, hälso- och pälsvård från bland annat dessa leverantörer.</p>
        </div>
        <ul class="chips" data-reveal>
          {leverantorer.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </section>
  </div>

  <SlutCta />
</Bas>

<script>
  // Filter (enbart förbättring – utan JS visas alla kategorier)
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  if (filter) {
    filter.hidden = false;
    const knappar = filter.querySelectorAll<HTMLButtonElement>('[data-visa]');
    const sektioner = document.querySelectorAll<HTMLElement>('[data-kategori]');
    const visa = (vad: string) => {
      knappar.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.visa === vad)));
      sektioner.forEach((s) => {
        s.hidden = vad !== 'alla' && s.dataset.kategori !== vad;
      });
    };
    knappar.forEach((k) => k.addEventListener('click', () => visa(k.dataset.visa!)));
    // Länkar som #hund / #katt förväljer kategori
    const fran = location.hash.replace('#', '');
    if (fran === 'hund' || fran === 'katt') visa(fran);
  }

  // Panelernas rörelse: parallax på bilden och en ljuspunkt som följer musen (av vid reducerad rörelse)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const paneler = [...document.querySelectorAll<HTMLElement>('.cat-panel')];
    let vantar = false;
    const rita = () => {
      vantar = false;
      for (const p of paneler) {
        const media = p.querySelector<HTMLElement>('[data-parallax]');
        const r = p.getBoundingClientRect();
        if (!media || r.bottom < 0 || r.top > window.innerHeight) continue;
        const framsteg = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight; // ≈ -1 … 1
        media.style.transform = `translate3d(0, ${(framsteg * -48).toFixed(1)}px, 0)`;
      }
    };
    const planera = () => {
      if (!vantar) {
        vantar = true;
        requestAnimationFrame(rita);
      }
    };
    window.addEventListener('scroll', planera, { passive: true });
    window.addEventListener('resize', planera);
    rita();

    if (window.matchMedia('(pointer: fine)').matches) {
      for (const p of paneler) {
        p.addEventListener('pointermove', (e) => {
          const r = p.getBoundingClientRect();
          p.style.setProperty('--mx', `${e.clientX - r.left}px`);
          p.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      }
    }
  }
</script>
