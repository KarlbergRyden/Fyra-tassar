---
/** Avslutande uppmaning – som originalets "Har du några frågor? Hör av dig till oss!"-banner. */
import Icon from './Icon.astro';
import Bild from './Bild.astro';
import { site } from '../data/site';

interface Props {
  rubrik?: string;
  text?: string;
}
const {
  rubrik = 'Har du några frågor? Hör av dig till oss!',
  text = `Vi finns på ${site.adress.gata} i Borlänge. Gratis parkering direkt utanför. Ring eller mejla om du vill kolla något innan du kommer.`,
} = Astro.props;
---

<section class="photo-band photo-band--center on-dark" aria-labelledby="slut-cta-rubrik">
  <Bild class="photo-band__img" namn="fragaband" sizes="100vw" />
  <div class="container photo-band__in">
    <h2 id="slut-cta-rubrik">{rubrik}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn" href={site.telefon.href} data-spor="ring"><Icon namn="phone" storlek={18} />Ring {site.telefon.visning}</a>
      <a class="btn btn--light" href="/kontakt/"><Icon namn="pin" storlek={18} />Hitta hit</a>
    </div>
  </div>
</section>
