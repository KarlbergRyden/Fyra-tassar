---
/** Samling enkla linjeikoner (24×24). Dekorativa som standard (aria-hidden). */
interface Props {
  namn: string;
  storlek?: number;
  titel?: string;
  class?: string;
}
const { namn, storlek = 24, titel, class: klass } = Astro.props;

const ikoner: Record<string, string> = {
