---
import Icon from './Icon.astro';
import type { Tjanst } from '../data/tjanster';

interface Props {
  tjanst: Tjanst;
}
const { tjanst } = Astro.props;
---

<article class="card card--link">
  <span class="card__icon"><Icon namn={tjanst.ikon} /></span>
  <h3>
    <a class="card__link" href={`/tjanster/${tjanst.slug}/`}>{tjanst.namn}</a>
  </h3>
  <p>{tjanst.sammanfattning}</p>
  {tjanst.pris.belopp && <span class="badge badge--amber">{tjanst.pris.rubrik}</span>}
  <span class="card__more" aria-hidden="true">Läs mer <Icon namn="arrow" storlek={18} /></span>
</article>
