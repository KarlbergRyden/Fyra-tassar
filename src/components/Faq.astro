---
import Icon from './Icon.astro';

interface Props {
  poster: { fraga: string; svar: string; lank?: { text: string; href: string } }[];
}
const { poster } = Astro.props;
---

<div class="faq">
  {
    poster.map((p) => (
      <details>
        <summary>
          <span>{p.fraga}</span>
          <Icon namn="chevron" />
        </summary>
        <div class="faq__body">
          <p>{p.svar}</p>
          {p.lank && (
            <a class="text-link" href={p.lank.href}>
              <span>{p.lank.text}</span>
              <Icon namn="arrow" storlek={18} />
            </a>
          )}
        </div>
      </details>
    ))
  }
</div>
